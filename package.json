{
  "name": "sura-agent",
  "version": "0.1.0",
  "description": "Stateful AI Assistant & Emotional Mentor extension for JupyterLab",
  "main": "lib/frontend/index.js",
  "types": "lib/frontend/index.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/*"
  ],
  "scripts": {
    "build": "tsc && jupyter labextension build . && node -e \"const fs=require('fs'); const p='src/sura_agent/labextension/package.json'; if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8').replace(/static\\\\\\\\/g,'static/').replace(/static\\\\/g,'static/');fs.writeFileSync(p,c);}\"",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/coreutils": "^6.0.0",
    "@jupyterlab/docregistry": "^4.0.0",
    "@jupyterlab/mainmenu": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/widgets": "^2.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "@types/react": "^18.0.0",
    "typescript": "~5.0.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "src/sura_agent/labextension",
    "sharedPackages": {
      "@jupyterlab/application": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/apputils": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/coreutils": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/docregistry": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/mainmenu": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/notebook": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/services": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@jupyterlab/ui-components": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "@lumino/widgets": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "react": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      },
      "react-dom": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      }
    }
  }
}